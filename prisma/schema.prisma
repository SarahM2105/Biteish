generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                     @id @default(uuid())
  email                    String                     @unique
  password                 String
  role                     Role                       @default(CUSTOMER)
  name                     String
  auditLogs                AuditLog[]
  favorites                Favorite[]
  notifications            Notification[]
  reservations             Reservation[]
  restaurants              Restaurant[]
  reviews                  Review[]
  ReservationChangeRequest ReservationChangeRequest[]
  interactions             UserInteraction[]
}

model Restaurant {
  id                        String                    @id @default(uuid())
  ownerId                   String
  name                      String
  description               String?
  location                  String
  latitude                  Float?
  longitude                 Float?
  estimatedSpendMin         Int?
  estimatedSpendMax         Int?
  automaticSpendCalculation Boolean                   @default(true)
  verified                  Boolean                   @default(false)
  bookingRule               BookingRule?
  favorites                 Favorite[]
  openingHours              OpeningHour[]
  reservations              Reservation[]
  owner                     User                      @relation(fields: [ownerId], references: [id])
  accessibility             RestaurantAccessibility[]
  tags                      RestaurantTag[]
  reviews                   Review[]
  tables                    Table[]
  zones                     Zone[]
  images                    RestaurantImage[]
  interactions              UserInteraction[]
  menuItems                 MenuItem[]
  menuSections              MenuSection[]
}

model RestaurantImage {
  id           String   @id @default(cuid())
  restaurantId String
  imageUrl     String
  altText      String?
  sortOrder    Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id           String      @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  price        Decimal     @db.Decimal(10, 2)
  dietaryInfo  String?
  isAvailable  Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sectionId    String
  section      MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemTags MenuItemTag[]

  @@index([restaurantId, sectionId, sortOrder])
}

model Zone {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  tables       Table[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model Table {
  id                   String                     @id @default(uuid())
  zoneId               String
  restaurantId         String
  capacity             Int
  active               Boolean                    @default(true)
  name                 String
  reservable           Boolean                    @default(true)
  reservations         Reservation[]
  restaurant           Restaurant                 @relation(fields: [restaurantId], references: [id])
  zone                 Zone                       @relation(fields: [zoneId], references: [id])
  unavailability       TableUnavailability[]
  requestedInChanges   ReservationChangeRequest[] @relation("RequestedChangeTable")
  tableTags            TableTag[]
  tableAccessibilities TableAccessibility[]

  @@unique([restaurantId, name])
}

model TableUnavailability {
  id       String   @id @default(uuid())
  tableId  String
  startsAt DateTime
  endsAt   DateTime
  reason   String
  table    Table    @relation(fields: [tableId], references: [id])
}

model Reservation {
  id                       String                     @id @default(uuid())
  restaurantId             String
  userId                   String?
  guestName                String?
  isWalkIn                 Boolean                    @default(false)
  tableId                  String
  startsAt                 DateTime
  endsAt                   DateTime
  partySize                Int
  notes                    String?
  checkedInAt              DateTime?
  status                   ReservationStatus          @default(PENDING)
  createdAt                DateTime                   @default(now())
  notifications            Notification[]
  qrToken                  QrToken?
  restaurant               Restaurant                 @relation(fields: [restaurantId], references: [id])
  table                    Table                      @relation(fields: [tableId], references: [id])
  user                     User?                      @relation(fields: [userId], references: [id])
  ReservationChangeRequest ReservationChangeRequest[]
}

model ReservationChangeRequest {
  id            String       @id @default(uuid())
  reservationId String
  requestedById String
  status        ChangeStatus @default(PENDING)
  newStartsAt   DateTime?
  newEndsAt     DateTime?
  newPartySize  Int?
  newTableId    String?
  newNotes      String?
  createdAt     DateTime     @default(now())
  reviewedAt    DateTime?

  reservation Reservation @relation(fields: [reservationId], references: [id])
  requestedBy User        @relation(fields: [requestedById], references: [id])
  newTable    Table?      @relation("RequestedChangeTable", fields: [newTableId], references: [id])
}

model QrToken {
  id            String      @id @default(uuid())
  reservationId String      @unique
  token         String      @unique
  expiresAt     DateTime
  used          Boolean     @default(false)
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

model Notification {
  id            String       @id @default(uuid())
  userId        String
  reservationId String?
  type          String
  title         String
  message       String
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

model Review {
  id            String        @id @default(uuid())
  userId        String
  restaurantId  String
  rating        Int
  comment       String?
  verifiedVisit Boolean       @default(false)
  createdAt     DateTime      @default(now())
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  images        ReviewImage[]
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  imageUrl  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId       String
  restaurantId String
  createdAt    DateTime   @default(now())
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, restaurantId])
}

model OpeningHour {
  id           String     @id @default(uuid())
  restaurantId String
  day          DayOfWeek
  opensAt      String
  closesAt     String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model BookingRule {
  id                        String     @id @default(uuid())
  restaurantId              String     @unique
  maxPartySize              Int
  daysAhead                 Int
  slotMinutes               Int
  turnoverMinutes           Int        @default(15)
  cancellationCutoffMinutes Int
  graceMinutes              Int        @default(15)
  restaurant                Restaurant @relation(fields: [restaurantId], references: [id])
}

model TagCategory {
  id          String @id @default(uuid())
  name        String @unique
  description String
  tags        Tag[]
}

model Tag {
  id           String            @id @default(uuid())
  categoryId   String
  name         String            @unique
  restaurants  RestaurantTag[]
  category     TagCategory       @relation(fields: [categoryId], references: [id])
  tableTags    TableTag[]
  menuItemTags MenuItemTag[]
  interactions UserInteraction[]
}

model RestaurantTag {
  id           String     @id @default(uuid())
  tagId        String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  tag          Tag        @relation(fields: [tagId], references: [id])

  @@unique([restaurantId, tagId])
}

model AccessibilityOption {
  id                        String                    @id @default(uuid())
  optionName                String                    @unique
  icon                      String?
  description               String
  restaurantAccessibilities RestaurantAccessibility[]
  tableAccessibilities      TableAccessibility[]
  interactions              UserInteraction[]
}

model RestaurantAccessibility {
  id           String              @id @default(uuid())
  restaurantId String
  optionId     String
  option       AccessibilityOption @relation(fields: [optionId], references: [id])
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, optionId])
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  occurredAt  DateTime    @default(now())
  action      String
  entity      AuditEntity
  entityId    String?
  description String
  user        User?       @relation(fields: [userId], references: [id])
}

model TableTag {
  id      String @id @default(uuid())
  tableId String
  tagId   String

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tableId, tagId])
}

model MenuItemTag {
  id         String   @id @default(uuid())
  menuItemId String
  tagId      String
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, tagId])
  @@index([tagId])
}

model MenuSection {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId, sortOrder])
}

model TableAccessibility {
  id        String   @id @default(uuid())
  tableId   String
  optionId  String
  createdAt DateTime @default(now())

  table  Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  option AccessibilityOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([tableId, optionId])
  @@index([optionId])
}

model UserInteraction {
  id           String             @id @default(uuid())
  userId       String
  restaurantId String?
  tagId        String?
  optionId     String?
  searchQuery  String?
  eventType    InteractionType
  source       InteractionSource?
  weight       Float              @default(1)
  metadata     Json?
  createdAt    DateTime           @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  tag        Tag?                 @relation(fields: [tagId], references: [id], onDelete: SetNull)
  option     AccessibilityOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([restaurantId, createdAt])
}

enum AuditEntity {
  USER
  RESTAURANT
  RESERVATION
  REVIEW
  TABLE
  BOOKING_RULE
  OPENING_HOUR
}

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ChangeStatus {
  PENDING
  APPROVED
  DECLINED
}

enum InteractionType {
  RESTAURANT_VIEW
  RECOMMENDATION_CLICK
  FAVOURITE_ADDED
  FAVOURITE_REMOVED
  BOOKING_CREATED
  BOOKING_COMPLETED
  REVIEW_CREATED
  SEARCH_PERFORMED
  FILTER_APPLIED
}

enum InteractionSource {
  DASHBOARD
  SEARCH
  RESTAURANT_PAGE
  FAVOURITES
  RECOMMENDATIONS
  BOOKING_FLOW
}
